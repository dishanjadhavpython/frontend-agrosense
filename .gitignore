# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source photography — originals, not served. Converted output lives in public/img.
data-sourse/

# The example is documentation, not a secret.
!.env.example

# Reading service runtime state: uploaded cards and the vector index.
backend/data/
__pycache__/
*.pyc

# Model artifacts and the rebuilt image dataset: regenerate with ml/*.py
ML/models/
ml/data/

# The soil image training set — 354 MB of photographs, and the source `git add
# -A` would have quietly staged. The models trained from it are what the app
# needs, and those are built into the container image rather than committed.
data set of the project/
